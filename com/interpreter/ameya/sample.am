print("################################################################");
print("#                   Program to Swap Numbers.                   #");
print("################################################################");
var a = 12;
var b = 21;

print("Before Swap");
print("a = " + a);
print("b = " + b);

var temp = a;
a = b;
b = temp;

print("After Swap");
print("a = " + a);
print("b = " + b);

