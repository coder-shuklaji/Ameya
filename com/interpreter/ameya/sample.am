  print("################################################################");
  print("#         Program to Print First 50 Even/Odd Numbers.          #");
  print("################################################################");

  var i = 1;
  while (i <= 50) {
    if (!(i&1)) {
      print(i + " is Even");
    }else {
      print(i + " is Odd");
    }
    i += 1;
  }
