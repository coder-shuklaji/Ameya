print("################################################################");
print("#        Program to Print First 50 Palindromic Numbers.        #");
print("################################################################");

var k = 1;
while (k <= 50) {
  var num = k;
  var paliNum = 0;
  while (num > 0) {
    paliNum = paliNum * 10 + (num % 10);
    num //= 10;
  }

  if (paliNum == k) {
    print(k + " is Palindromic Number.");
  }
  k += 1;
} 
